{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "Personalized Offers for Spacefast demo",
    "description": "A WooCommerce demo store (Ollie theme, 100 products, 20 customers, 50 orders) with Personalized Offers for Spacefast and a few ready offers.",
    "author": "Micemade",
    "categories": [
      "WooCommerce",
      "Marketing"
    ]
  },
  "landingPage": "/wp-admin/admin.php?page=personalized-offers-for-spacefast",
  "preferredVersions": {
    "php": "8.4",
    "wp": "latest"
  },
  "features": {
    "networking": true
  },
  "login": true,
  "plugins": [
    "wordpress-importer",
    "woocommerce"
  ],
  "steps": [
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/mu-plugins/rewrite.php",
      "data": "<?php /* Use pretty permalinks */ add_action( 'after_setup_theme', function() { global $wp_rewrite; $wp_rewrite->set_permalink_structure('/%postname%/'); $wp_rewrite->flush_rules(); } );"
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/mu-plugins/pofsf-playground.php",
      "data": "<?php /* Personalized Offers demo in WordPress Playground. */ /* Playground serves the site from a service worker, so previews need the admin's origin. */ add_filter( 'pofsf_preview_same_origin', '__return_true' ); /* Background requests to admin-ajax.php are blocked by the browser in Playground (CORS). */ add_filter( 'woocommerce_background_image_regeneration', '__return_false' ); add_filter( 'action_scheduler_allow_async_request_runner', '__return_false' );"
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/Micemade/playground/main/releases/personalized-offers-for-spacefast-v1.0.0.zip"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "wordpress.org/themes",
        "slug": "ollie"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-load.php'; delete_transient( '_wc_activation_redirect' );"
    },
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "Personalized Offers demo",
        "blogdescription": "A demo store for Personalized Offers for Spacefast",
        "woocommerce_store_address": "Korzo 1",
        "woocommerce_store_city": "Rijeka",
        "woocommerce_store_postcode": "51000",
        "woocommerce_default_country": "HR:HR-08",
        "woocommerce_currency": "EUR",
        "woocommerce_weight_unit": "kg",
        "woocommerce_dimension_unit": "cm",
        "woocommerce_onboarding_profile": {
          "skipped": true
        },
        "woocommerce_allow_tracking": "no",
        "woocommerce_coming_soon": "no",
        "woocommerce_bacs_settings": {
          "enabled": "yes"
        },
        "woocommerce_cod_settings": {
          "enabled": "yes"
        }
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/mu-plugins/pofsf-demo-import.php",
      "data": "<?php /* Faster demo import: product images are already small, so no extra sizes are made. Removed after setup. */ add_filter( 'intermediate_image_sizes_advanced', '__return_empty_array' ); add_filter( 'big_image_size_threshold', '__return_false' );"
    },
    {
      "step": "importWxr",
      "file": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/Micemade/playground/main/WXR-imports/pofsf-playground.xml"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/pofsf-customers-orders.json",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/Micemade/playground/main/WXR-imports/pofsf-customers-orders.json"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/pofsf-demo-setup.php",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/Micemade/playground/main/blueprints/pofsf-demo-setup.php"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-load.php'; require '/wordpress/wp-content/pofsf-demo-setup.php';"
    },
    {
      "step": "rm",
      "path": "/wordpress/wp-content/pofsf-demo-setup.php"
    },
    {
      "step": "rm",
      "path": "/wordpress/wp-content/mu-plugins/pofsf-demo-import.php"
    }
  ]
}
